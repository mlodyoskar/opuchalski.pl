{
  "name": "opuchalski.pl",
  "author": "mlodyoskar",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "dev": "velite dev & next dev --turbo",
    "build": "velite build --clean && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "velite build --clean && next typegen && tsc --pretty --noEmit",
    "format": "prettier --write .",
    "knip": "knip"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run type-check && lint-staged",
      "pre-push": "pnpm run type-check"
    }
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "pnpm format"
    ]
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "date-fns": "^2.29.2",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.29",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "husky": "^8.0.1",
    "knip": "^5.70.1",
    "lint-staged": "^13.0.3",
    "postcss": "^8.5.14",
    "prettier": "^2.7.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "velite": "^0.3.0",
    "webpack": "^5.97.1"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^2.3.2",
      "postcss": "^8.5.14"
    }
  }
}
