{
  "name": "opuchalski.pl",
  "author": "mlodyoskar",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "knip": "knip"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run type-check && lint-staged",
      "pre-push": "pnpm run type-check"
    }
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "pnpm format"
    ]
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.9",
    "date-fns": "^2.29.2",
    "next": "^16.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^18.0.6",
    "autoprefixer": "^10.4.9",
    "husky": "^8.0.1",
    "knip": "^5.70.1",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.21",
    "prettier": "^2.7.1",
    "tailwindcss": "^3.1.8",
    "typescript": "^5.9.3",
    "velite": "^0.3.0",
    "webpack": "^5.97.1"
  }
}
